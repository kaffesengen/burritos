# Kopier denne filen til .env.local og fyll inn.
# .env.local er gitignorert og skal ikke committes.

# Project URL fra Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co

# Publishable key (safe in browser). Tidligere kalt anon/public.
SUPABASE_ANON_KEY=

# Secret key (service_role). Bare til å kjøre supabase-schema.sql.
# Skal ALDRI i supabase-config.js eller i nettleseren.
SUPABASE_SERVICE_ROLE_KEY=
