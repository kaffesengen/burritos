# Kopier denne filen til .env.local og fyll inn.
# .env.local er gitignorert og skal ikke committes.

# Project URL fra Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co

# anon / public-nøkkelen (den som heter anon eller publishable).
# Denne er ment å ligge i klienten.
SUPABASE_ANON_KEY=

# Valgfritt: service_role. Brukes bare til å kjøre supabase-schema.sql.
# Skal ALDRI i supabase-config.js eller i nettleseren.
SUPABASE_SERVICE_ROLE_KEY=
